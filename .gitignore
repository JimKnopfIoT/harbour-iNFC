translations/*.ts
!translations/*-de.ts

# Built binaries (qmake TARGET lands in the project root)
/harbour-infc
/harbour-infc-um

# SDK / packaging output
/RPMS/
/installroot/
/.mb2/

# QtCreator
*.autosave
*.qmlproject.user
*.qmlproject.user.*

# Local notes, session data and other private bits - never publish
.claude/
CLAUDE.md
CLAUDE-CONTINUE.md
*.local.sh


# Icon design sources / reference material (local only)
/media/
